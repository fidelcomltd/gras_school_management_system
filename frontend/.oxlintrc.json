{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    // React 19 automatic JSX runtime — importing React just to render is obsolete.
    "react/react-in-jsx-scope": "off",
    // `import './styles/index.css'` and `import '@testing-library/jest-dom/vitest'`
    // are side-effect imports by design.
    "import/no-unassigned-import": "off",
    // Axios genuinely exposes helpers on its default export.
    "import/no-named-as-default-member": "off",
    // `__testing` / `__resetAuthSession` mark test-only seams on purpose.
    "no-underscore-dangle": "off",

    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": ["buttonVariants", "inputVariants"]
      }
    ],

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-autofocus": "warn",
    "jsx-a11y/role-has-required-aria-props": "error",

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "warn",

    "promise/no-return-wrap": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "eqeqeq": ["error", "smart"]
  },
  "overrides": [
    {
      "files": ["src/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "react/only-export-components": "off",
        "typescript/no-explicit-any": "off",
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "node_modules", "src/api/**"]
}
