# Copy to `.env` and fill in. Never commit `.env`.
# Every variable here is declared in src/config/env-values.ts and validated at boot.
#
# Only VITE_-prefixed variables reach the browser bundle, and everything in this
# file IS shipped to the client. Nothing secret belongs here — no API keys, no
# credentials. Privileged values live on the backend.

# Display name for the portal (page title, shell header).
VITE_APP_NAME="Golden Royal Ark School Portal"

# development | staging | production
VITE_APP_ENV="development"

# Absolute base URL of the REST API, no trailing slash.
VITE_API_BASE_URL="https://localhost:7001"

# Per-request timeout in milliseconds (1 - 120000).
VITE_API_TIMEOUT_MS="30000"

# Treat an access token as expired this many seconds early, to absorb clock
# skew and in-flight latency (0 - 600).
VITE_AUTH_EXPIRY_LEEWAY_SECONDS="30"

# Mounts development-only tooling. Must be "false" in production.
VITE_ENABLE_DEV_TOOLS="true"
