<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure implements Application's abstractions: EF Core persistence, secret
    providers, external clients. Nothing references Infrastructure except the Api
    composition root.
  -->

  <PropertyGroup>
    <RootNamespace>SchoolManagement.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchoolManagement.Application\SchoolManagement.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Integration tests seed and assert through the context's internal DbSet properties. -->
    <InternalsVisibleTo Include="SchoolManagement.IntegrationTests" />
    <InternalsVisibleTo Include="SchoolManagement.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- TASK-0003: Argon2id password hashing (spec 9.1). -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <!-- Design-time only: enables `dotnet ef migrations add`. Not shipped at runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
