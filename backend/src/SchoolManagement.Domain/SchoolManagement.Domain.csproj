<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain has ZERO package references and ZERO project references, by design.
    Enforced by DependencyDirectionTests. If you are about to add one, you are about to
    put infrastructure concerns in the domain — see CONTRIBUTING.md "Layering".
  -->

  <PropertyGroup>
    <RootNamespace>SchoolManagement.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- TASK-0005a: SchoolProfile has no public factory (it is a migration-seeded singleton, never
         created by application code) — unit tests need SchoolProfile.CreateForTesting, an internal
         seam, to build an instance at all. Matches the grant every other project already makes to
         the same test assembly. -->
    <InternalsVisibleTo Include="SchoolManagement.UnitTests" />
  </ItemGroup>

</Project>
