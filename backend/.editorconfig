# EditorConfig — formatting AND analyser severity for the whole backend.
#
# This file is a quality gate, not a preference sheet. `EnforceCodeStyleInBuild` plus
# `TreatWarningsAsErrors` (Directory.Build.props) means a violation here fails the build.
#
# RULE FOR CONTRIBUTORS: every rule relaxed below `warning` carries a comment explaining
# why. A severity downgrade with no justification is rejected in review. Do not add
# `#pragma warning disable` or `[SuppressMessage]` without an inline reason either.

root = true

[*]
charset = utf-8
# LF everywhere, including on Windows. CI runs on Linux, the sibling frontend/ is a
# Node app that is LF-native, and normalising here avoids the "entire file changed"
# diffs that mixed line endings produce. .gitattributes enforces it at checkout.
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Windows shell scripts genuinely require CRLF; cmd.exe mis-parses LF continuations.
[*.{cmd,bat}]
end_of_line = crlf

[*.{csproj,props,targets,config,xml,yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing whitespace is meaningful (hard line break) in Markdown.
trim_trailing_whitespace = false

[*.{cs,vb}]
indent_size = 4
tab_width = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# ---------------------------------------------------------------------------
# Naming conventions
# ---------------------------------------------------------------------------
dotnet_naming_rule.interfaces_start_with_i.severity = error
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.interface_symbols.applicable_accessibilities = *
dotnet_naming_style.prefix_i_pascal.required_prefix = I
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case

dotnet_naming_rule.types_are_pascal_case.severity = error
dotnet_naming_rule.types_are_pascal_case.symbols = type_symbols
dotnet_naming_rule.types_are_pascal_case.style = pascal
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,enum,delegate,event
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.members_are_pascal_case.severity = error
dotnet_naming_rule.members_are_pascal_case.symbols = member_symbols
dotnet_naming_rule.members_are_pascal_case.style = pascal
dotnet_naming_symbols.member_symbols.applicable_kinds = method,property
dotnet_naming_symbols.member_symbols.applicable_accessibilities = public,internal,protected,protected_internal

# Static readonly fields are effectively constants and read as PascalCase. This rule must come
# BEFORE the instance-field rule: .NET naming rules are evaluated in declaration order and the
# first matching rule wins, so putting the broader rule first would make this one unreachable.
dotnet_naming_rule.private_static_readonly_are_pascal.severity = error
dotnet_naming_rule.private_static_readonly_are_pascal.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_are_pascal.style = pascal
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private,internal
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static,readonly

dotnet_naming_rule.private_fields_underscore_camel.severity = error
dotnet_naming_rule.private_fields_underscore_camel.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case

# Const FIELDS are PascalCase. Deliberately NOT applied to local constants: a local const is a local,
# and camelCase reads correctly there. Requiring PascalCase for locals is not a .NET convention and
# would make every `const int maxRetries = 3;` inside a method a build error.
dotnet_naming_rule.constants_are_pascal.severity = error
dotnet_naming_rule.constants_are_pascal.symbols = constant_symbols
dotnet_naming_rule.constants_are_pascal.style = pascal
dotnet_naming_symbols.constant_symbols.applicable_kinds = field
dotnet_naming_symbols.constant_symbols.required_modifiers = const

# ---------------------------------------------------------------------------
# Language and formatting style (all enforced at build)
# ---------------------------------------------------------------------------
[*.cs]
csharp_using_directive_placement = outside_namespace:error
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:warning
# Primary constructors are the house style for dependency-injected classes: they remove
# the field/assignment boilerplate that DI classes are otherwise 80% made of. Left at
# `silent` rather than enforced because they are wrong for entities (EF materialisation)
# and for types with constructor validation.
csharp_style_prefer_primary_constructors = true:silent
csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent

dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_readonly_field = true:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:silent
dotnet_style_prefer_conditional_expression_over_return = true:silent
dotnet_style_namespace_match_folder = true:warning

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_blocks = true

# Sealed by default: unsealed public classes are an extension point you did not design.
dotnet_diagnostic.CA1852.severity = warning

# ---------------------------------------------------------------------------
# Formatting / code-style diagnostics promoted to build failures
# ---------------------------------------------------------------------------
dotnet_diagnostic.IDE0055.severity = warning   # formatting — keeps `dotnet format` clean
dotnet_diagnostic.IDE0161.severity = warning   # file-scoped namespaces
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary usings

# IDE0058: value of an expression is unused. Fires constantly on the fluent builder
# pattern that all of ASP.NET Core's configuration API is written in
# (`app.UseRouting()`, `builder.Services.AddX()`), where discarding is correct.
dotnet_diagnostic.IDE0058.severity = none

# ---------------------------------------------------------------------------
# XML documentation (CS1591)
# ---------------------------------------------------------------------------
# Off by default because requiring /// on every internal Domain/Infrastructure member is
# noise. Re-enabled as an ERROR further down for Api and Application, whose public types
# ARE the OpenAPI contract and must be self-describing (root CLAUDE.md §3, brief §F).
dotnet_diagnostic.CS1591.severity = none

# ---------------------------------------------------------------------------
# Justified analyser relaxations
# ---------------------------------------------------------------------------

# CA2007 / RCS1090: "call ConfigureAwait". ASP.NET Core installs no SynchronizationContext,
# so ConfigureAwait(false) is pure noise here. (It would matter in a shipped library.)
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.RCS1090.severity = none

# CA1062: "validate arguments of public methods". Nullable reference types are enabled
# repo-wide and enforced as errors, which covers this statically. Adding runtime null
# guards to every public method duplicates that at a cost in readability.
dotnet_diagnostic.CA1062.severity = none

# CA1812: "avoid uninstantiated internal classes". Handlers, validators, options types,
# and EF entity configurations are all constructed reflectively by DI / EF Core, which
# the analyser cannot see. Enforcing it would push us to make internals public.
dotnet_diagnostic.CA1812.severity = none

# CA1515: "consider making public types internal". Endpoint modules, DTOs, and the
# generated OpenAPI contract types must be public; integration tests also need to reach
# Program. The dependency-direction rules are enforced by architecture tests instead.
dotnet_diagnostic.CA1515.severity = none

# CA1032 / CA1064 / RCS1194: standard exception constructor sets. This codebase returns
# Result<T> for expected failures (docs/adr/0004) and uses exceptions only for genuinely
# exceptional cases, where a deliberately narrow constructor surface is correct.
dotnet_diagnostic.CA1032.severity = none
dotnet_diagnostic.CA1064.severity = none
dotnet_diagnostic.RCS1194.severity = none

# CA1724: "type name conflicts with a namespace name". Our namespaces are feature-shaped
# (…Application.Ping), so a type named after its feature is the intended convention.
dotnet_diagnostic.CA1724.severity = none

# CA1054 / CA1056 / CA2234: "use System.Uri instead of string". Configuration binding and
# OpenAPI schema generation both work in strings; converting at the options boundary and
# back adds a failure mode without adding safety.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA2234.severity = none

# ---------------------------------------------------------------------------
# Deliberately kept as errors — these are the rules that catch real bugs
# ---------------------------------------------------------------------------
dotnet_diagnostic.CA1849.severity = error   # do not call blocking methods in async code
dotnet_diagnostic.CA2016.severity = error   # forward the CancellationToken
dotnet_diagnostic.CA2012.severity = error   # use ValueTask correctly
dotnet_diagnostic.CA1848.severity = error   # use LoggerMessage delegates (source-gen logging)
dotnet_diagnostic.CA1305.severity = error   # specify IFormatProvider
dotnet_diagnostic.CA1310.severity = error   # specify StringComparison for correctness
dotnet_diagnostic.CA2100.severity = error   # SQL injection via string concatenation
dotnet_diagnostic.CA3003.severity = error   # file path injection
dotnet_diagnostic.CA3075.severity = error   # insecure DTD processing
dotnet_diagnostic.CA5350.severity = error   # weak crypto
dotnet_diagnostic.CA5351.severity = error   # broken crypto
dotnet_diagnostic.CA5359.severity = error   # do not disable certificate validation
dotnet_diagnostic.CA5391.severity = error   # antiforgery tokens
dotnet_diagnostic.CA5394.severity = error   # insecure randomness

# ---------------------------------------------------------------------------
# Path-scoped overrides
# ---------------------------------------------------------------------------

# Api and Application expose the HTTP contract. Undocumented public members here are a
# build failure, because a missing /// becomes a missing description in openapi.json.
[src/SchoolManagement.Api/**.cs]
dotnet_diagnostic.CS1591.severity = error

[src/SchoolManagement.Application/**.cs]
dotnet_diagnostic.CS1591.severity = error

# CA1040 ("avoid empty interfaces") is inverted in this folder. The empty marker interfaces here
# are not accidental abstraction — they ARE the enforcement mechanism. Constraining a behaviour to
# IBaseCommand is what makes the DI container physically unable to wrap a query in a transaction,
# replacing a runtime `if (request is ICommand)` that somebody could forget. Removing them would
# trade a compile-time guarantee for a convention.
[src/SchoolManagement.Application/Abstractions/Messaging/*.cs]
dotnet_diagnostic.CA1040.severity = none

# EF Core migrations are generated code. We keep them under source control and never
# hand-tune them for style, so style rules do not apply.
[src/SchoolManagement.Infrastructure/Persistence/Migrations/**.cs]
dotnet_diagnostic.CS1591.severity = none
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_analyzer_diagnostic.category-Design.severity = none
dotnet_analyzer_diagnostic.category-Maintainability.severity = none
dotnet_analyzer_diagnostic.category-Naming.severity = none
dotnet_analyzer_diagnostic.category-Performance.severity = none
generated_code = true

# Tests. Relaxations here are about test readability, never about correctness.
[tests/**.cs]
# xUnit test names use Method_Scenario_Expectation, which trips the underscore rule.
dotnet_diagnostic.CA1707.severity = none
# Test classes are instantiated by the xUnit runner, not by us.
dotnet_diagnostic.CA1515.severity = none
# Structured-logging performance rules are irrelevant in tests.
dotnet_diagnostic.CA1848.severity = none
# Tests legitimately assert on nested/large literal data and long member chains.
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA2000.severity = none
# Test data is deliberately invariant; ordinal/culture pedantry adds nothing.
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
