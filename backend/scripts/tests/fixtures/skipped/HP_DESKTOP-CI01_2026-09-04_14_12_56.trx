<?xml version="1.0" encoding="UTF-8"?>
<!--
  Fixture for backend/scripts/tests/gate-summary.tests.ps1: reproduces the real xunit v3 dynamic-skip
  shape (Assert.Skip) — total=31, passed=0, failed=0, notExecuted=0. xunit v3 does not increment
  notExecuted for a dynamic skip, which is why Get-TrxSummary derives Skipped as
  total - passed - failed rather than trusting that counter. A fully-skipped project still writes
  TestDefinitions (the test starts, then calls Assert.Skip), confirmed against a real no-database
  run on this machine (artifacts/coverage/HP_DESKTOP-GPLBVV9_2026-09-04_14_12_56.trx).

  Filename and <UnitTest storage="..."> are shaped like REAL VSTest output on purpose (a realistic
  <user>_<machine>_<timestamp>.trx name, carrying no project name at all) so the self-test proves
  Get-SuiteName reads the suite from inside the file, not from a filename a real trx never has.
  Not a real dotnet test output — hand-authored.
-->
<TestRun id="33333333-3333-3333-3333-333333333333" name="fixture-skipped" xmlns="http://microsoft.com/schemas/VisualStudio/TeamTest/2010">
