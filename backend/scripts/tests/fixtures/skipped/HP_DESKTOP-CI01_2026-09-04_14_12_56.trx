    <UnitTest name="SchoolManagement.IntegrationTests.Endpoints.WhoAmIEndpointTests.Get_ReturnsIdentity" storage="c:\users\hp\desktop\web-apps\school-management-proj\backend\tests\schoolmanagement.integrationtests\bin\release\net10.0\schoolmanagement.integrationtests.dll" id="b2c3d4e5-6789-01bc-def2-234567890abc">
