<?xml version="1.0" encoding="utf-8"?>
<!--
  Supply-chain hygiene: <clear /> removes any feed inherited from a machine-level
  NuGet.config, so a build here can only ever restore from nuget.org. If you add a
  private feed, add it with an explicit <packageSourceMapping> entry so a public
  package can never be silently shadowed by a private one of the same name.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
