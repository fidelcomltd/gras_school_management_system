<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast, in-process, no I/O. If a test here needs a database it belongs in IntegrationTests. -->

  <PropertyGroup>
    <RootNamespace>SchoolManagement.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SchoolManagement.Api\SchoolManagement.Api.csproj" />
    <ProjectReference Include="..\..\src\SchoolManagement.Application\SchoolManagement.Application.csproj" />
    <ProjectReference Include="..\..\src\SchoolManagement.Domain\SchoolManagement.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <!--
    TASK-0071 stage 3: the §8.4 fixture data is linked (not project-referenced) from IntegrationTests
    so its self-check test here (ResultComputationFixtureSelfCheckTests) and the fixture-driven
    integration test both read the exact same rows — one physical file, no risk of the two drifting
    apart. The data file itself has no dependency beyond the BCL, so linking it costs nothing here.
  -->
  <ItemGroup>
    <Compile Include="..\SchoolManagement.IntegrationTests\Fixtures\ResultComputationFixtureData.cs"
             Link="Application\Results\Computation\ResultComputationFixtureData.cs" />
  </ItemGroup>

  <!--
    TASK-0005b stage A: a real JPEG carrying EXIF GPS, and a real PNG carrying an eXIf chunk, for
    SkiaSchoolImageProcessorTests' metadata-stripping proof. Embedded (not CopyToOutputDirectory) so
    the test reads them via GetManifestResourceStream regardless of the runner's working directory.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Infrastructure\Settings\Fixtures\logo-with-gps-exif.jpg" />
    <EmbeddedResource Include="Infrastructure\Settings\Fixtures\logo-with-exif-chunk.png" />
    <!-- TASK-0005b stage B1: 40x30 stored pixels, a 4x4 red marker at the stored top-left corner,
         tagged EXIF orientation 6 ("rotate 90 CW to display correctly"). -->
    <EmbeddedResource Include="Infrastructure\Settings\Fixtures\orientation-6.jpg" />
  </ItemGroup>

</Project>
