<Project>

  <!--
    Central Package Management. THIS IS THE ONLY FILE THAT MAY CONTAIN A PACKAGE VERSION.
    Project files reference packages without a Version attribute; a version there is a
    build error. This makes version drift between projects structurally impossible.

    Adding a package requires a justification line in the task card (root CLAUDE.md §8).
    Nothing is pinned to a floating version or a wildcard.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Analysers">
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="4.15.0" />
    <!--
      TASK-0026. Pins the analyzer CODE, not just the ruleset `AnalysisLevel` selects from it.

      Without this, `EnableNETAnalyzers` runs whatever copy of Microsoft.CodeAnalysis.NetAnalyzers
      ships INSIDE the resolved .NET SDK (under Sdks/Microsoft.NET.Sdk/analyzers/ in the SDK
      install), which is a property of the machine, not the repo. Worse,
      `Microsoft.NET.Sdk.Analyzers.targets` (in that same SDK) hard-codes `_LatestAnalysisLevel`
      per SDK BUILD, and its own comment says that value is bumped as the platform matures, which
      can land in a later 10.0.1xx patch — i.e. WITHIN the feature band `global.json`'s
      `rollForward: latestPatch` (TASK-0024) already tolerates. Verified on this machine (SDK
      10.0.100) with `dotnet build -getProperty:EffectiveAnalysisLevel`: `AnalysisLevel=latest-All`
      resolves to `9.0`, not `10.0`, so `latest` is not even internally consistent with this being
      a net10.0 TFM, let alone stable across a CI SDK patch.

      An explicit PackageReference to this package (Directory.Build.props) supersedes the
      SDK-bundled copy, so the rule IMPLEMENTATIONS running are the ones named here on every
      machine. Version matches the SDK feature band `global.json` pins (10.0.1xx, GA), rather
      than floating with whichever patch resolves.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100" />
  </ItemGroup>

  <ItemGroup Label="Application layer">
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Authentication">
    <!--
      TASK-0003. Argon2id password hashing (spec 9.1). Chosen over hand-rolling Argon2 (a memory-hard
      KDF is not something to reimplement) and over BCrypt/PBKDF2 (spec 9.1 fixes Argon2id
      specifically). MIT licensed, no transitive dependencies beyond the BCL. Provides the raw KDF
      only — this project's own PHC-like encoding (Argon2idPasswordHasher) embeds the cost parameters
      and salt alongside the hash, per spec 9.1's "cost parameters stored with the hash".
    -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--
      Maps PascalCase CLR names to snake_case database identifiers. Justification: unquoted
      identifiers in PostgreSQL fold to lower case, so PascalCase tables force every hand-written
      query, psql session and migration script to double-quote everything. One small
      single-purpose package removes a permanent papercut for anyone touching SQL directly.
    -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="API surface">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      SECURITY PIN — transitive dependency, not referenced directly by any project.

      Microsoft.AspNetCore.OpenApi 10.0.10 resolves Microsoft.OpenApi 2.0.0, which is affected by
      CVE-2026-49451 (GHSA-v5pm-xwqc-g5wc, High, CVSS 7.5): a crafted OpenAPI document with circular
      schema references causes a stack overflow and terminates the process that parses it.
      Affected: >= 2.0.0-preview.11, <= 2.7.4. Patched: 2.7.5 in the 2.x line.

      Pinned to the latest 2.x rather than 3.x: the ASP.NET Core package is built against the 2.x
      object model, and 3.x is a major version with breaking API changes. This works because
      CentralPackageTransitivePinningEnabled is set in Directory.Build.props, which lets a
      PackageVersion entry raise a transitive dependency without adding a direct reference.

      Found by the CI vulnerability-scan gate. Re-check this pin when Microsoft.AspNetCore.OpenApi is
      next upgraded: once it resolves a patched version itself, this entry becomes redundant and should
      be removed rather than left to rot.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.17" />
  </ItemGroup>

  <ItemGroup Label="Observability">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.2.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <!--
      Npgsql emits its own ActivitySource, so Postgres spans come from this stable
      package rather than OpenTelemetry.Instrumentation.EntityFrameworkCore, which
      is still pre-release. Deliberate: no beta packages in the scaffold.
    -->
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Image processing">
    <!--
      TASK-0005b. Human ruling 2026-09-21: SkiaSharp (MIT), for re-encoding school logo and head
      teacher signature uploads server-side — strips EXIF/eXIf metadata (spec 9.6) by decoding and
      re-encoding rather than copying, and produces the 200px/64px logo derivatives. Chosen over
      ImageSharp (dual-licensed, requires a paid license once revenue-generating) and over
      System.Drawing.Common (Windows-only in practice; deprecated for cross-platform use).
      SkiaSharp.NativeAssets.Linux.NoDependencies supplies statically-linked native binaries for the
      VPS target (human ruling: hosting is a VPS) without requiring system libfontconfig/libEGL etc
      to be present on the box — the plain SkiaSharp.NativeAssets.Linux package does not include
      Linux native assets at all; a Linux native-asset package must be referenced explicitly.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.152.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
    <!--
      Human ruling 2026-09-22: QuestPDF for every PDF (pin slips now; result sheets and portal PDFs later).
      Community licence: free for organisations under USD 1M annual revenue, which a single school is.
      Bundles its own native renderer for Linux, so the VPS needs nothing extra.
    -->
    <PackageVersion Include="QuestPDF" Version="2026.9.0" />
    <!-- MIT. The result sheet's verification QR code (spec 6.9.6); PngByteQRCode has no System.Drawing dependency. -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup Label="Health checks">
    <!--
      AddDbContextCheck (from this package) attempts a real connection through the already-configured
      context, so no separate health-check package is needed and the connection string is not
      duplicated. A dedicated Npgsql health-check package was considered and rejected on that basis.
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Configuration">
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.10" />
    <!-- Provides OptionsBuilder<T>.Bind, used to bind options sections outside the Api project. -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <!-- Provides OptionsBuilder<T>.ValidateOnStart, so misconfiguration fails at boot. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!--
      NOT pinned here (tried, reverted, TASK-0026): xunit.v3 3.2.2 pulls in xunit.v3.core.mtp-v1,
      which depends on "Microsoft.Testing.Platform.MSBuild": "1.9.1" as a floor, not an exact pin,
      and this repo has no NuGet lock file (packages.lock.json) anywhere, so a future restore could
      resolve a higher version. That version is also what decides TestingPlatformDotnetTestSupport's
      default (see tests/Directory.Build.props, where it is set explicitly instead). Adding an
      explicit PackageVersion entry here to pin it the same way as the Microsoft.OpenApi entry
      below broke restore on this machine (NETSDK1013, empty TargetFramework) because promoting it
      from implicit-transitive to centrally-pinned makes its buildMultiTargeting assets import
      unconditionally, including into the SDK's outer cross-targeting evaluation pass (which always
      runs with an empty TargetFramework, even for a single-TFM project). Left floating; the
      explicit property in tests/Directory.Build.props is the actual, verified-working fix for the
      behaviour that matters.
    -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.0.0" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
  </ItemGroup>

</Project>
