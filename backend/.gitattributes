# Normalise line endings so a Windows checkout and a Linux CI runner agree.
# Without this, `dotnet format --verify-no-changes` passes locally and fails in CI
# (or vice versa) purely on line endings. See .editorconfig `end_of_line = lf`.

* text=auto eol=lf

# Windows shell scripts must keep CRLF — cmd.exe mis-parses LF line continuations.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.dll binary
*.exe binary
*.pfx binary
*.snk binary

# Diff/merge hints.
*.cs        text diff=csharp
*.csproj    text merge=union
*.slnx      text
*.sln       text eol=crlf
*.json      text
*.md        text
