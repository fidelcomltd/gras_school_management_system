# Golden Royal Ark School website — environment contract.
# Copy to .env.local for local work. In Netlify set these under Site configuration → Environment variables,
# per deploy context (Production / Deploy previews / Branch deploys) where they differ.
# Every NEXT_PUBLIC_ value is baked in AT BUILD TIME: change it, then redeploy.
# All are validated in config/env.ts; anything optional falls back to the default shown.

# ── Site ──────────────────────────────────────────────────────────────────────────────────────────
# Canonical origin for metadata, sitemap, JSON-LD and share cards. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://goldenroyalark.com
# production | preview. Anything but "production" sends noindex and disallows crawling (netlify.toml
# sets "preview" for deploy previews and branch deploys automatically).
NEXT_PUBLIC_SITE_ENV=production

# ── Result portal ────────────────────────────────────────────────────────────────────────────────
# Every "Check results" / "Result Portal" link. Production and staging differ:
#   production  https://results.goldenroyalark.com              (the default when unset)
#   staging     https://staging-api.goldenroyalark.com/portal   (set for previews in netlify.toml)
NEXT_PUBLIC_RESULT_PORTAL_URL=https://results.goldenroyalark.com

# ── Contact details (shown on every page and in structured data) ────────────────────────────────
# Phone in international format, digits only after the +. Displayed as "+234 813 647 5557".
NEXT_PUBLIC_CONTACT_PHONE=+2348136475557
NEXT_PUBLIC_CONTACT_EMAIL=goldenroyalark@gmail.com
NEXT_PUBLIC_ADDRESS_STREET=World Bank Area, Zone E
NEXT_PUBLIC_ADDRESS_CITY=Owerri
NEXT_PUBLIC_ADDRESS_REGION=Imo State
# Optional: exact coordinates improve the map pin and local search. Leave blank until confirmed.
NEXT_PUBLIC_GEO_LAT=
NEXT_PUBLIC_GEO_LNG=

# ── Social ───────────────────────────────────────────────────────────────────────────────────────
# Both default to the school's own profiles; set these only to override them:
#   TikTok    https://www.tiktok.com/@goldenroyalarkschool
#   Facebook  https://www.facebook.com/profile.php?id=100095517095251
# (If the Facebook page later gets a username, e.g. facebook.com/goldenroyalark, put it here.)
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# ── Search Console (optional) ───────────────────────────────────────────────────────────────────
# The content value of Google's HTML-tag verification method.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Contact form → email via Resend (server only, never NEXT_PUBLIC) ────────────────────────────
# Without RESEND_API_KEY the form still works locally (the message is logged), but production returns
# an error so a misconfigured deploy is noticed.
RESEND_API_KEY=
# Where enquiries go. Defaults to NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_FORM_TO=
# Sender. Its domain must be verified in Resend (add goldenroyalark.com under Resend → Domains).
CONTACT_FORM_FROM=Golden Royal Ark School Website <website@goldenroyalark.com>
